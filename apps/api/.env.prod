# Server Configuration
HOST=0.0.0.0
PORT=3001
NODE_ENV=production

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/club_prod

# Authentication
JWT_SECRET=your-production-jwt-secret-key
ADMIN_SECRET_KEY=your-production-admin-secret-key

# Email Configuration
SENDGRID_API_KEY=your-production-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# CORS Configuration
CORS_ORIGIN=https://yourdomain.com

# Logging
LOG_LEVEL=info